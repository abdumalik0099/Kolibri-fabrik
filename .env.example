# ==============================================
# KOLIBRI FABRIK - Environment Variables
# ==============================================
# Bu faylni .env nomi bilan saqlang (local uchun)
# Vercel'ga deploy qilganda bu o'zgaruvchilarni
# Vercel Dashboard > Settings > Environment Variables ga qo'shing

# Telegram Bot Token (BotFather'dan olinadi)
# server.js va api/file/[fileId].js ikkisi ham shu tokenni ishlatadi
TELEGRAM_BOT_TOKEN=your_bot_token_here

# server.js uchun (local development)
BOT_TOKEN=your_bot_token_here

# Telegram Chat/Channel ID (video yuklash uchun)
# server.js uchun
CHAT_ID=-100xxxxxxxxxx

# Vercel serverless function uchun
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
